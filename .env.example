# ============================================================
# Electronic LP - Variables de Entorno
# Copiar este archivo como .env.local y completar los valores
# ============================================================

# ─── Base de Datos ───────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/electronic_lp?schema=public"

# ─── NextAuth / Auth.js ──────────────────────────────────────
# Genera con: openssl rand -base64 32
AUTH_SECRET="tu-secret-aqui-generado-con-openssl"
NEXTAUTH_URL="http://localhost:3000"

# ─── Mercado Pago ────────────────────────────────────────────
# Obtener en: https://www.mercadopago.com.ar/settings/account/credentials
MERCADOPAGO_ACCESS_TOKEN="APP_USR-xxxx-xxxx-xxxx-xxxx"
MERCADOPAGO_PUBLIC_KEY="APP_USR-xxxx-xxxx-xxxx"
# URL base para webhooks (en producción: tu dominio)
MERCADOPAGO_WEBHOOK_SECRET="tu-webhook-secret"
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY="APP_USR-xxxx-xxxx-xxxx"

# ─── Email (Nodemailer) ───────────────────────────────────────
# Para Gmail: usa una App Password (no tu contraseña normal)
# Guía: https://support.google.com/accounts/answer/185833
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="electroniclpok@gmail.com"
SMTP_PASSWORD="tu-app-password-de-gmail"
SMTP_FROM="Electronic LP <electroniclpok@gmail.com>"

# ─── Upload de Imágenes (Cloudinary) ─────────────────────────
# Crear cuenta gratis en: https://cloudinary.com
CLOUDINARY_CLOUD_NAME="tu-cloud-name"
CLOUDINARY_API_KEY="tu-api-key"
CLOUDINARY_API_SECRET="tu-api-secret"
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="tu-cloud-name"

# ─── App ─────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Electronic LP"

# ─── Contacto ─────────────────────────────────────────────────
NEXT_PUBLIC_EMAIL="electroniclpok@gmail.com"
NEXT_PUBLIC_WHATSAPP="5492214358517"
NEXT_PUBLIC_INSTAGRAM="https://instagram.com/electronic.lp"
